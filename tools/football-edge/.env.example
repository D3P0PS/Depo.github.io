# Copia questo file in .env e incolla le tue chiavi.
# .env e' gia' in .gitignore: non finira' mai in un commit.
# Verifica con:  python3 edge_scan.py --check-keys

# --- obbligatoria: dati storici, calendario e forma ---
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- quote: ne basta UNA delle due ---
# SharpAPI (usata di default se presente) - https://sharpapi.io/
SHARPAPI_KEY=

# The Odds API - https://the-odds-api.com/#get-access
ODDS_API_KEY=
